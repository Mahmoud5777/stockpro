<section *hasPermission="'{{entity.permissionCode}}:consultation'" class="{{entity.kebabName}}-list">
    <header>
        <h1>{{entity.tagLabel}}</h1>
        <input type="search" [(ngModel)]="search" (keyup.enter)="searchItems()" placeholder="Rechercher" />
    </header>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                {{#each entity.fields}}
                <th>{{nameCap}}</th>
                {{/each}}
            </tr>
        </thead>
        <tbody>
            <tr *ngFor="let item of (data$ | async)?.content">
                <td>{{'{{ item.id }}'}}</td>
                {{#each entity.fields}}
                <td>{{'{{ item.'}}{{name}}{{' }}'}}</td>
                {{/each}}
            </tr>
        </tbody>
    </table>
</section>