spring:
application:
name: stockpro-back
datasource:
url: ${DB_URL:jdbc:h2:mem:stockpro;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE}
username: ${DB_USERNAME:sa}
password: ${DB_PASSWORD:}
jpa:
hibernate:
ddl-auto: update
open-in-view: false
show-sql: false
flyway:
enabled: false
sql:
init:
mode: never
servlet:
multipart:
max-file-size: 10MB
max-request-size: 10MB

server:
port: ${SERVER_PORT:8081}

jwt:
secret: ${JWT_SECRET:uXgJcleM3EDsS4ij8V/pa59hte2RSQaWqlhPheMS2533CKPg8iJMzbJu5MmxZR9O}
expiration-ms: ${JWT_EXPIRATION_MS:900000}
refresh-expiration-ms: ${JWT_REFRESH_EXPIRATION_MS:86400000}

app:
cors:
allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:*,http://127.0.0.1:*}

springdoc:
api-docs:
path: /v3/api-docs
swagger-ui:
path: /swagger-ui.html